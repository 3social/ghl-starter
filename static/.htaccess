# ─────────────────────────────────────────────────────────────────────────────
#  ghl.flamiagroup.com — configuración de servidor
#
#  Este archivo es el espejo exacto de lo que corre en producción, más
#  compresión y caché. Si se edita en el servidor y no aquí, el cambio se
#  pierde en el siguiente despliegue.
#
#  ORDEN DE LAS REGLAS: una RewriteCond aplica ÚNICAMENTE a la RewriteRule
#  que la sigue de inmediato. Por eso los dos `!-f` / `!-d` van pegados a la
#  regla de fallback: si se suben arriba, la de fallback queda sin
#  condiciones y reescribe TODO —logo.png, sitemap.xml, los módulos de
#  _app/— hacia index.html.
# ─────────────────────────────────────────────────────────────────────────────

Options -MultiViews
RewriteEngine On
RewriteBase /

# Hostinger inyecta un CSP restrictivo que bloquea los módulos ES de
# SvelteKit. Lo retiramos y ponemos uno propio que sí permite ejecutarlos.
# `connect-src https:` es lo que habilita el fetch del formulario al webhook.
Header always unset Content-Security-Policy
Header always set Content-Security-Policy "default-src 'self' https: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; img-src 'self' data: https:; connect-src 'self' https:;"

# Ruta /gracias → gracias.html
RewriteRule ^gracias/?$ /gracias.html [L]

# Sirve archivos y directorios existentes; fallback a index.html para el resto.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# ── Cabeceras ───────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
	# El sitemap debe servirse como XML, no como texto plano.
	<FilesMatch "\.xml$">
		Header set Content-Type "application/xml; charset=utf-8"
	</FilesMatch>

	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Compresión ──────────────────────────────────────────────────────────────
# Core Web Vitals es factor de posicionamiento: cada KB que no viaja es LCP
# que no se retrasa.
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
	AddOutputFilterByType DEFLATE application/javascript application/x-javascript
	AddOutputFilterByType DEFLATE application/json application/xml
	AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Caché ───────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
	ExpiresActive On

	# Los assets de _app/immutable llevan hash en el nombre: cachearlos un año
	# es seguro, porque un cambio de contenido cambia la URL.
	<FilesMatch "\.(js|css|woff2)$">
		ExpiresDefault "access plus 1 year"
		Header set Cache-Control "public, immutable, max-age=31536000"
	</FilesMatch>

	ExpiresByType image/png "access plus 6 months"
	ExpiresByType image/svg+xml "access plus 6 months"
	ExpiresByType image/webp "access plus 6 months"

	# El HTML nunca se cachea agresivamente: es lo que cambia al redesplegar.
	ExpiresByType text/html "access plus 0 seconds"
</IfModule>
